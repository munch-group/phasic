    def test_tied_epochs_still_export_master_values(joint_rows):
        jc, rows = joint_rows
        s = jc.svgd(rows, epoch_starts=EPOCHS, fixed=[(1, 0.3)], tied=[(0, [0, 1])],
                    prior=[gauss(), None], n_particles=6, n_iterations=3,
